{
  "backend": {
    "name": "github",
    "repo": "grittydude/ikechukwu-achom-portfolio",
    "branch": "main",
    "commit_messages": {
      "create": "Create {{collection}} “{{slug}}” (via admin)",
      "update": "Update {{collection}} “{{slug}}” (via admin)",
      "delete": "Delete {{collection}} “{{slug}}” (via admin)",
      "uploadMedia": "Upload “{{path}}” (via admin)",
      "deleteMedia": "Delete “{{path}}” (via admin)"
    }
  },
  "site_url": "https://grittydude.github.io/ikechukwu-achom-portfolio/",
  "display_url": "https://grittydude.github.io/ikechukwu-achom-portfolio/",
  "media_folder": "public/uploads",
  "public_folder": "/uploads",
  "collections": [
    {
      "name": "projects",
      "label": "Projects",
      "label_singular": "Project",
      "description": "Each project gets a card and a case-study page at /projects/<file name>.",
      "folder": "content/projects",
      "extension": "json",
      "format": "json",
      "create": true,
      "delete": true,
      "identifier_field": "title",
      "slug": "{{slug}}",
      "summary": "{{title}} — {{tagline}}",
      "sortable_fields": [
        "order",
        "title"
      ],
      "media_folder": "/public/projects",
      "public_folder": "/projects",
      "fields": [
        {
          "name": "order",
          "label": "Order",
          "widget": "number",
          "value_type": "int",
          "default": 500,
          "hint": "Lower numbers come first on the site (10, 20, 30…)."
        },
        {
          "name": "title",
          "label": "Title",
          "widget": "string"
        },
        {
          "name": "tagline",
          "label": "Tagline",
          "widget": "string",
          "hint": "Short descriptor shown in italics, e.g. “Subscription & renewal tracker”."
        },
        {
          "name": "kind",
          "label": "Type",
          "widget": "select",
          "options": [
            {
              "label": "Personal product",
              "value": "personal"
            },
            {
              "label": "Client project",
              "value": "client"
            },
            {
              "label": "Company project",
              "value": "employer"
            },
            {
              "label": "Program",
              "value": "program"
            }
          ]
        },
        {
          "name": "platform",
          "label": "Platform",
          "widget": "string",
          "hint": "e.g. Android (Flutter), Web",
          "required": false
        },
        {
          "name": "status",
          "label": "Status",
          "widget": "string",
          "hint": "e.g. Live, In development, Client project",
          "required": false
        },
        {
          "name": "roles",
          "label": "Show on these portfolios",
          "widget": "select",
          "multiple": true,
          "required": false,
          "options": [
            {
              "label": "Mobile Engineering",
              "value": "mobile"
            },
            {
              "label": "Web Development",
              "value": "web"
            },
            {
              "label": "Product Design",
              "value": "design"
            },
            {
              "label": "Product & Technical Leadership",
              "value": "leadership"
            }
          ]
        },
        {
          "name": "featured",
          "label": "Feature on the homepage",
          "widget": "boolean",
          "default": false,
          "required": false
        },
        {
          "name": "confidential",
          "label": "Confidential (NDA / company-owned)",
          "widget": "boolean",
          "default": false,
          "required": false,
          "hint": "Shows a confidentiality notice and never shows a screenshot gallery."
        },
        {
          "name": "summary",
          "label": "Summary",
          "widget": "text",
          "hint": "One or two sentences for cards and link previews."
        },
        {
          "name": "myRole",
          "label": "My role",
          "widget": "string",
          "required": false
        },
        {
          "name": "stack",
          "label": "Stack / tools",
          "widget": "list",
          "required": false
        },
        {
          "name": "links",
          "label": "Links",
          "widget": "object",
          "required": false,
          "collapsed": true,
          "fields": [
            {
              "name": "live",
              "label": "Live site URL",
              "widget": "string",
              "required": false
            },
            {
              "name": "demo",
              "label": "Demo URL",
              "widget": "string",
              "required": false
            },
            {
              "name": "store",
              "label": "App store URL",
              "widget": "string",
              "required": false
            },
            {
              "name": "code",
              "label": "Source code URL",
              "widget": "string",
              "hint": "Only shown when “Show source code links” is on in Site settings.",
              "required": false
            }
          ]
        },
        {
          "name": "highlight",
          "label": "Headline stat (replaces the device illustration)",
          "widget": "object",
          "required": false,
          "collapsed": true,
          "fields": [
            {
              "name": "value",
              "label": "Value",
              "widget": "string",
              "hint": "e.g. 10,000+",
              "required": false
            },
            {
              "name": "label",
              "label": "Label",
              "widget": "string",
              "hint": "e.g. participants · 7 bootcamps",
              "required": false
            }
          ]
        },
        {
          "name": "screenshot",
          "label": "Cover image",
          "widget": "object",
          "required": false,
          "collapsed": true,
          "hint": "Used on project cards and at the top of the case study.",
          "fields": [
            {
              "name": "src",
              "label": "Image",
              "widget": "image",
              "required": false
            },
            {
              "name": "alt",
              "label": "Alt text (describe the image)",
              "widget": "string",
              "required": false
            }
          ]
        },
        {
          "name": "screens",
          "label": "Screens gallery",
          "widget": "list",
          "required": false,
          "summary": "{{fields.caption}}",
          "fields": [
            {
              "name": "src",
              "label": "Image",
              "widget": "image"
            },
            {
              "name": "alt",
              "label": "Alt text (describe the image)",
              "widget": "string"
            },
            {
              "name": "caption",
              "label": "Caption",
              "widget": "string",
              "required": false
            }
          ]
        },
        {
          "name": "screenSlots",
          "label": "Screens still to capture",
          "widget": "list",
          "required": false,
          "hint": "Placeholders shown only in local development, as a to-do list."
        },
        {
          "name": "caseStudy",
          "label": "Case study",
          "widget": "object",
          "hint": "Leave any section empty and it simply won't appear on the site.",
          "fields": [
            {
              "name": "overview",
              "label": "Overview",
              "widget": "text",
              "required": false
            },
            {
              "name": "problem",
              "label": "The problem",
              "widget": "text",
              "required": false
            },
            {
              "name": "contribution",
              "label": "My role & contribution (what I personally did)",
              "widget": "list",
              "required": false
            },
            {
              "name": "team",
              "label": "Team context",
              "widget": "text",
              "required": false
            },
            {
              "name": "constraints",
              "label": "Constraints",
              "widget": "list",
              "required": false
            },
            {
              "name": "approach",
              "label": "Approach",
              "widget": "text",
              "required": false
            },
            {
              "name": "decisions",
              "label": "Key decisions & trade-offs",
              "widget": "list",
              "required": false,
              "summary": "{{fields.title}}",
              "fields": [
                {
                  "name": "title",
                  "label": "Decision",
                  "widget": "string"
                },
                {
                  "name": "body",
                  "label": "Why",
                  "widget": "text"
                }
              ]
            },
            {
              "name": "outcomes",
              "label": "Outcomes (real results only)",
              "widget": "list",
              "required": false
            },
            {
              "name": "lessons",
              "label": "Lessons learned",
              "widget": "text",
              "required": false
            }
          ]
        }
      ]
    },
    {
      "name": "site",
      "label": "Site content",
      "files": [
        {
          "name": "personal",
          "label": "Profile & contact",
          "file": "content/personal.json",
          "format": "json",
          "fields": [
            {
              "name": "name",
              "label": "Full name",
              "widget": "string"
            },
            {
              "name": "firstName",
              "label": "First name",
              "widget": "string"
            },
            {
              "name": "lastName",
              "label": "Last name",
              "widget": "string"
            },
            {
              "name": "initials",
              "label": "Initials",
              "widget": "string"
            },
            {
              "name": "identity",
              "label": "Identity",
              "widget": "string",
              "hint": "Short positioning label, e.g. Product Builder."
            },
            {
              "name": "headline",
              "label": "Headline",
              "widget": "string",
              "hint": "Shown under your name, split on “ and ”."
            },
            {
              "name": "intro",
              "label": "Intro paragraph",
              "widget": "text"
            },
            {
              "name": "currentRole",
              "label": "Current role",
              "widget": "string"
            },
            {
              "name": "alsoRole",
              "label": "Second current role",
              "widget": "string",
              "required": false
            },
            {
              "name": "currentCompany",
              "label": "Current company",
              "widget": "string"
            },
            {
              "name": "location",
              "label": "Location",
              "widget": "string",
              "required": false
            },
            {
              "name": "photo",
              "label": "Portrait (transparent cut-out)",
              "widget": "image",
              "media_folder": "/public/images",
              "public_folder": "/images",
              "required": false
            },
            {
              "name": "email",
              "label": "Email",
              "widget": "string"
            },
            {
              "name": "phone",
              "label": "Phone",
              "widget": "string",
              "required": false
            },
            {
              "name": "whatsapp",
              "label": "WhatsApp number (display)",
              "widget": "string",
              "required": false
            },
            {
              "name": "whatsappHref",
              "label": "WhatsApp link",
              "widget": "string",
              "hint": "https://wa.me/234…",
              "required": false
            },
            {
              "name": "linkedin",
              "label": "LinkedIn URL",
              "widget": "string"
            },
            {
              "name": "linkedinHandle",
              "label": "LinkedIn handle",
              "widget": "string",
              "required": false
            },
            {
              "name": "github",
              "label": "GitHub URL",
              "widget": "string"
            },
            {
              "name": "githubHandle",
              "label": "GitHub handle",
              "widget": "string",
              "required": false
            },
            {
              "name": "githubLegacy",
              "label": "Older GitHub URL",
              "widget": "string",
              "required": false
            },
            {
              "name": "stats",
              "label": "Headline stats",
              "widget": "list",
              "required": false,
              "summary": "{{fields.num}} {{fields.label}}",
              "hint": "Verified numbers only. The first three show on the About section.",
              "fields": [
                {
                  "name": "num",
                  "label": "Number",
                  "widget": "string"
                },
                {
                  "name": "label",
                  "label": "Label",
                  "widget": "string"
                },
                {
                  "name": "source",
                  "label": "Source",
                  "widget": "string",
                  "hint": "cv or owner",
                  "required": false
                }
              ]
            }
          ]
        },
        {
          "name": "roles",
          "label": "Portfolios (role pages)",
          "file": "content/roles.json",
          "format": "json",
          "fields": [
            {
              "name": "roles",
              "label": "Portfolios",
              "widget": "list",
              "summary": "{{fields.label}} ({{fields.path}})",
              "hint": "Each entry is its own page. Changing an id or path breaks links you've already shared.",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "string",
                  "hint": "Short key used by projects and experience, e.g. mobile."
                },
                {
                  "name": "path",
                  "label": "URL path",
                  "widget": "string",
                  "hint": "Starts with /, e.g. /mobile-engineer"
                },
                {
                  "name": "label",
                  "label": "Name",
                  "widget": "string"
                },
                {
                  "name": "short",
                  "label": "Short name",
                  "widget": "string"
                },
                {
                  "name": "eyebrow",
                  "label": "Eyebrow",
                  "widget": "string"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "highlight",
                  "label": "Highlighted title text",
                  "widget": "string"
                },
                {
                  "name": "intro",
                  "label": "Intro",
                  "widget": "text"
                },
                {
                  "name": "glance",
                  "label": "At a glance",
                  "widget": "list",
                  "required": false,
                  "summary": "{{fields.label}}: {{fields.value}}",
                  "fields": [
                    {
                      "name": "label",
                      "label": "Label",
                      "widget": "string"
                    },
                    {
                      "name": "value",
                      "label": "Value",
                      "widget": "string"
                    }
                  ]
                },
                {
                  "name": "capabilities",
                  "label": "Capabilities",
                  "widget": "list",
                  "required": false,
                  "summary": "{{fields.title}}",
                  "fields": [
                    {
                      "name": "title",
                      "label": "Capability",
                      "widget": "string"
                    },
                    {
                      "name": "body",
                      "label": "Description",
                      "widget": "text"
                    },
                    {
                      "name": "evidence",
                      "label": "Evidence (projects)",
                      "widget": "relation",
                      "collection": "projects",
                      "value_field": "{{slug}}",
                      "search_fields": [
                        "title"
                      ],
                      "display_fields": [
                        "title"
                      ],
                      "multiple": true,
                      "required": false
                    }
                  ]
                },
                {
                  "name": "marquee",
                  "label": "Marquee words",
                  "widget": "list",
                  "required": false
                },
                {
                  "name": "meta",
                  "label": "Link preview / SEO",
                  "widget": "object",
                  "collapsed": true,
                  "fields": [
                    {
                      "name": "title",
                      "label": "Page title",
                      "widget": "string"
                    },
                    {
                      "name": "description",
                      "label": "Description",
                      "widget": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "experience",
          "label": "Experience",
          "file": "content/experience.json",
          "format": "json",
          "fields": [
            {
              "name": "items",
              "label": "Experience",
              "widget": "list",
              "summary": "{{fields.period}} · {{fields.role}} — {{fields.company}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "string",
                  "hint": "Unique short key, e.g. kodehauz-lead."
                },
                {
                  "name": "period",
                  "label": "Period",
                  "widget": "string",
                  "hint": "e.g. 2021 — Present"
                },
                {
                  "name": "role",
                  "label": "Role",
                  "widget": "string"
                },
                {
                  "name": "company",
                  "label": "Company",
                  "widget": "string"
                },
                {
                  "name": "roles",
                  "label": "Show on these portfolios",
                  "widget": "select",
                  "multiple": true,
                  "required": false,
                  "options": [
                    {
                      "label": "Mobile Engineering",
                      "value": "mobile"
                    },
                    {
                      "label": "Web Development",
                      "value": "web"
                    },
                    {
                      "label": "Product Design",
                      "value": "design"
                    },
                    {
                      "label": "Product & Technical Leadership",
                      "value": "leadership"
                    }
                  ]
                },
                {
                  "name": "summary",
                  "label": "Summary",
                  "widget": "text"
                },
                {
                  "name": "highlights",
                  "label": "Highlights",
                  "widget": "list",
                  "required": false
                },
                {
                  "name": "tags",
                  "label": "Tags",
                  "widget": "list",
                  "required": false
                }
              ]
            }
          ]
        },
        {
          "name": "credentials",
          "label": "Education & certifications",
          "file": "content/credentials.json",
          "format": "json",
          "fields": [
            {
              "name": "education",
              "label": "Education",
              "widget": "list",
              "summary": "{{fields.qualification}}, {{fields.school}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "string"
                },
                {
                  "name": "school",
                  "label": "School",
                  "widget": "string"
                },
                {
                  "name": "qualification",
                  "label": "Qualification",
                  "widget": "string"
                },
                {
                  "name": "year",
                  "label": "Year",
                  "widget": "string"
                }
              ]
            },
            {
              "name": "certifications",
              "label": "Certifications",
              "widget": "list",
              "summary": "{{fields.title}} ({{fields.year}})",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "string"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "issuer",
                  "label": "Issuer",
                  "widget": "string"
                },
                {
                  "name": "year",
                  "label": "Year",
                  "widget": "string"
                },
                {
                  "name": "roles",
                  "label": "Show on these portfolios",
                  "widget": "select",
                  "multiple": true,
                  "required": false,
                  "options": [
                    {
                      "label": "Mobile Engineering",
                      "value": "mobile"
                    },
                    {
                      "label": "Web Development",
                      "value": "web"
                    },
                    {
                      "label": "Product Design",
                      "value": "design"
                    },
                    {
                      "label": "Product & Technical Leadership",
                      "value": "leadership"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "name": "toolkit",
          "label": "Toolkit",
          "file": "content/toolkit.json",
          "format": "json",
          "fields": [
            {
              "name": "groups",
              "label": "Tool groups",
              "widget": "list",
              "summary": "{{fields.title}}",
              "fields": [
                {
                  "name": "id",
                  "label": "Id",
                  "widget": "string"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "widget": "string"
                },
                {
                  "name": "roles",
                  "label": "Show on these portfolios",
                  "widget": "select",
                  "multiple": true,
                  "required": false,
                  "options": [
                    {
                      "label": "Mobile Engineering",
                      "value": "mobile"
                    },
                    {
                      "label": "Web Development",
                      "value": "web"
                    },
                    {
                      "label": "Product Design",
                      "value": "design"
                    },
                    {
                      "label": "Product & Technical Leadership",
                      "value": "leadership"
                    }
                  ]
                },
                {
                  "name": "items",
                  "label": "Tools",
                  "widget": "list",
                  "summary": "{{fields.name}}",
                  "fields": [
                    {
                      "name": "name",
                      "label": "Name",
                      "widget": "string"
                    },
                    {
                      "name": "mark",
                      "label": "Badge letters",
                      "widget": "string",
                      "hint": "1–3 characters, e.g. Fl"
                    }
                  ]
                }
              ]
            },
            {
              "name": "disciplines",
              "label": "Marquee band words (homepage & About)",
              "widget": "list",
              "required": false
            }
          ]
        },
        {
          "name": "settings",
          "label": "Site settings",
          "file": "content/settings.json",
          "format": "json",
          "fields": [
            {
              "name": "showSourceLinks",
              "label": "Show “Source code” links on projects",
              "widget": "boolean",
              "default": false,
              "required": false
            }
          ]
        }
      ]
    }
  ]
}
